# Copia este archivo como .env y reemplaza TODOS los valores. El .env nunca se sube a Git.

# Base de datos local (docker-compose.yml usa estos tres valores).
POSTGRES_USER=ecoruta
POSTGRES_PASSWORD=CLAVE
POSTGRES_DB=ecoruta_db
# El mismo usuario, clave y base de arriba; el puerto 5433 es el del docker-compose.
DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@localhost:5433/ecoruta_db

# Genera cada una con: python -c "import secrets; print(secrets.token_hex(32))"
# (una distinta para cada variable; no las compartas).
SECRET_KEY=GENERAR_CON_SECRETS_TOKEN_HEX
DEVICE_API_KEY=GENERAR_CON_SECRETS_TOKEN_HEX
ACCESS_TOKEN_MINUTES=480

# Opcional: cuenta municipalidad con la que inicia sesión el simulador.
SIMULADOR_EMAIL=municipalidad@ejemplo.test
SIMULADOR_PASSWORD=CLAVE_DE_ESA_CUENTA

# Opcional: contraseña de las cuentas demo (scripts/crear_usuarios_demo.py).
# Si no se define, el script la pide por consola.
# ECORUTA_DEMO_PASSWORD=
